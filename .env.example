# Copy to `.env` for local development. `.env` is gitignored; never commit secrets.
# Real environment variables override values in `.env`.

# Required. PostgreSQL connection URL.
DATABASE_URL=postgres://wired:wired@localhost:5432/wired

# Required. Public origin of this instance: http(s) only, with a host and no
# path or query. A trailing slash is stripped; a non-default port is kept.
BASE_URL=https://social.example

# Optional. Address to listen on (default: 127.0.0.1:4000).
# BIND_ADDR=127.0.0.1:4000

# Optional. Instance display name (default: Wired).
# INSTANCE_NAME=Wired

# Optional. Short instance description
# (default: A Pleroma-compatible instance).
# INSTANCE_DESCRIPTION=A Pleroma-compatible instance

# Optional. Admin contact email (unset by default).
# CONTACT_EMAIL=admin@example.org

# Optional. Comma-separated content language codes (default: en).
# INSTANCE_LANGUAGES=en

# Optional. Maximum characters per status (default: 5000). `POST
# /api/v1/statuses` counts them the way clients do, charging each bare URL 23
# characters, and answers a longer post 422
# {"error":"The status is over the character limit"}.
# MAX_STATUS_CHARS=5000

# Optional. Maximum media attachments per status (default: 4).
# MAX_MEDIA_ATTACHMENTS=4

# Optional. Maximum options per poll (default: 20).
# MAX_POLL_OPTIONS=20

# Optional. Maximum characters per chat message (default: 5000, Pleroma's
# `[:instance, :chat_limit]`). `POST /api/v1/pleroma/chats/{id}/messages`
# answers longer content 400 {"error":"The message is too long"}. The chat
# model independently refuses source text longer than 5000 characters when
# storing it, so raising this above 5000 has no effect on what is stored.
# MAX_CHAT_MESSAGE_CHARS=5000

# Optional. Maximum characters in a media attachment's description (alt
# text) (default: 1500, Mastodon's limit). `PUT /api/v1/media/{id}` refuses
# a longer `description` with 422 {"error":"Description too long"}.
# MAX_MEDIA_DESCRIPTION=1500

# Optional. Maximum characters in an account display name (default: 50,
# Mastodon's limit). `PATCH /api/v1/accounts/update_credentials` refuses a
# longer `display_name` with 422
# {"error":"Name is too long (maximum is 50 characters)"}.
# MAX_DISPLAY_NAME_CHARS=50

# Optional. Maximum characters in a profile note (bio) (default: 5000,
# Pleroma's `[:limiter, :user_bio_length]`).
# `PATCH /api/v1/accounts/update_credentials` refuses a longer `note` with
# 422 {"error":"Bio is too long (maximum is 5000 characters)"}.
# MAX_BIO_CHARS=5000

# Optional. Maximum number of profile metadata entries an account may
# store via `fields_attributes` (default: 4, Mastodon's limit).
# `PATCH /api/v1/accounts/update_credentials` refuses more entries with
# 422 {"error":"Too many fields"}.
# MAX_PROFILE_FIELDS=4

# Optional. Maximum characters in a report's `comment` (default: 1000,
# Mastodon's limit). `POST /api/v1/reports` refuses a longer comment with
# 422 {"error":"Validation failed: Comment is too long (maximum is 1000
# characters)"}.
# MAX_REPORT_COMMENT=1000

# Optional. Allow registering local accounts without an email address.
# Accepts true/false or 1/0, case-insensitive (default: false).
# ACCOUNTS_EMAIL_OPTIONAL=false

# Optional. Minimum length of a registration or reset password, in
# characters (default: 8).
# MIN_PASSWORD_LENGTH=8

# Optional. Lifetime granted to newly issued OAuth access tokens, in
# seconds (default: 2592000 — 30 days). The /oauth token endpoints stamp
# a token's `valid_until` with now() plus this value.
# OAUTH_TOKEN_TTL_SECS=2592000

# Optional. Lifetime of a password-reset token, in seconds (default:
# 86400 — 24 hours). `POST /auth/password` mints a token that is valid
# while it is unused and its issue time is within this window; the
# `GET`/`POST /api/v1/pleroma/password_reset` endpoints refuse it
# afterwards.
# PASSWORD_RESET_TTL_SECS=86400

# Optional. External OAuth login providers, as the JSON text of an array of
# provider objects (default: [] — no provider is configured, so every
# /oauth/prepare_request and /oauth/{provider} path answers for any name).
# Each object needs name, client_id, client_secret, authorize_url, token_url
# and userinfo_url; scopes and the four *_field names are optional (uid_field
# defaults to "id", the others to "" = the provider does not say). A field
# name is a dotted path into the provider's userinfo document. Invalid JSON
# refuses startup. The client_secret is never written to a log.
# OAUTH_PROVIDERS=[{"name":"github","client_id":"...","client_secret":"...","authorize_url":"https://github.com/login/oauth/authorize","token_url":"https://github.com/login/oauth/access_token","userinfo_url":"https://api.github.com/user","scopes":"read:user user:email","uid_field":"id","nickname_field":"login","email_field":"email","name_field":"name"}]

# Optional. Serve the MongooseIM auth endpoints `GET /user_exists` and
# `GET /check_password` for an external MongooseIM `extauth` http backend.
# Accepts true/false or 1/0, case-insensitive (default: false); while off,
# both paths answer the standard 404 {"error":"Not found"}.
# MONGOOSEIM_ENABLED=false

# Optional. Announce a captcha provider on `GET /api/v1/pleroma/captcha`.
# Accepts true/false or 1/0, case-insensitive (default: false). No captcha
# is implemented: with the flag off the endpoint answers
# {"type":"none"}; with it on, 501 {"error":"Captcha is not implemented"}.
# CAPTCHA_ENABLED=false

# Optional. Whether the instance accepts new local registrations. Accepts
# true/false or 1/0, case-insensitive (default: true, Pleroma's default);
# NodeInfo reports the state as `openRegistrations`.
# REGISTRATIONS_OPEN=true

# Optional. Whether registration invite tokens substitute for open
# registrations. Accepts true/false or 1/0, case-insensitive (default:
# false). While REGISTRATIONS_OPEN is true this changes nothing: the
# registration `token` parameter is optional and ignored. While
# registrations are closed, with this on a valid invite token
# (models/invite_tokens, administered by the later admin tickets) is
# required to register — anything else is 400 {"error":"Invalid token"} —
# and with it off every attempt is refused. `GET /api/v1/instance` reports
# the state as `invites_enabled`, NodeInfo as `invitesEnabled`.
# INVITES_ENABLED=false

# Optional. Comma-separated list of frontends clients may pick at
# `PUT /api/v1/pleroma/preferred_frontend` (default: empty — no frontend is
# pickable, so `GET /api/v1/pleroma/preferred_frontend/available` answers
# `[]` and every pick is refused 422 {"error":"Invalid frontend"}).
# AVAILABLE_FRONTENDS=pleroma-fe

# Optional. Sign outgoing actor `GET`s with the instance actor's HTTP
# Signature (draft-cavage), so peers in authorized-fetch mode answer them.
# Accepts true/false or 1/0, case-insensitive (default: true). The instance
# actor (`{BASE_URL}/internal/fetch`) is created on first use.
# SIGN_FETCHES=true

# Optional. Require a valid HTTP Signature on `GET`s of the ActivityPub
# actor routes. Accepts true/false or 1/0, case-insensitive (default:
# false); while off, actor documents answer anonymous requests, and while
# on, unsigned or unverifiable requests get 401. `GET /internal/fetch`
# (the signer's own document) is never gated.
# AUTHORIZED_FETCH=false

# Optional. Whether this instance federates at all. Accepts true/false or
# 1/0, case-insensitive (default: true). While off, every ActivityPub inbox
# `POST` (`/inbox`, `/users/{nickname}/inbox` and `/internal/fetch/inbox`)
# is refused with 403 {"error":"Federation is disabled"} — before
# authentication — and outbound delivery queues nothing.
# FEDERATION_ENABLED=true

# Optional. Report pool and liveness data on
# `GET /api/v1/pleroma/healthcheck`. Accepts true/false or 1/0,
# case-insensitive (default: false); while off the path answers the
# standard 404 {"error":"Not found"}. When on, the answer is 200 or 503
# with the sqlx pool counts and a `SELECT 1` probe result.
# HEALTHCHECK_ENABLED=false

# Optional. Maximum size of one uploaded file in a multipart request, in
# bytes (default: 16000000). Keep it under the middleware's 16 MiB overall
# body cap unless the upload router raises that too.
# UPLOAD_LIMIT_BYTES=16000000

# Optional. Maximum number of files in one multipart request (default: 16).
# UPLOAD_MAX_FILES=16

# Optional. Maximum size of the `avatar` image accepted by
# `PATCH /api/v1/accounts/update_credentials`, in bytes (default: 2000000,
# Pleroma's avatar limit). A larger avatar is refused with 422
# {"error":"File is too large"}; the `header` and
# `pleroma_background_image` parts are measured by BANNER_LIMIT_BYTES.
# AVATAR_LIMIT_BYTES=2000000

# Optional. Maximum size of the `header` and `pleroma_background_image`
# images accepted by `PATCH /api/v1/accounts/update_credentials`, in bytes
# (default: 4000000, Pleroma's banner and background limit). A larger one is
# refused with 422 {"error":"File is too large"}.
# BANNER_LIMIT_BYTES=4000000

# Optional. Hard cap on one inbound ActivityPub inbox request body, in
# bytes (default: 1048576 — 1 MiB). The SignedActivity extractor answers a
# larger body 413 {"error":"Payload too large"}; keep it under the
# middleware's 16 MiB overall body cap.
# INBOX_MAX_BYTES=1048576

# Optional. Maximum pixel count (width times height) of an uploaded image
# (default: 40000000 — 40 megapixels). `POST /api/v1/media` and
# `POST /api/v2/media` read an image's header before decoding it and reject
# a larger one with 422 {"error":"Image too large"}; undecodable image bytes
# are rejected with 422 {"error":"Invalid image"}.
# MAX_IMAGE_PIXELS=40000000

# Optional. Allow outbound HTTP requests to private, loopback, and other
# reserved addresses, disabling the SSRF guard. Accepts true/false or 1/0,
# case-insensitive (default: false). Development and test only: a federating
# instance must keep the guard on.
# HTTP_ALLOW_PRIVATE_HOSTS=false

# Optional. Directory uploaded files are stored in, relative paths are read
# from the working directory (default: ./uploads). It must be writable by the
# server; the files in it are public to anyone who holds their URL.
# UPLOADS_DIR=./uploads

# Optional. Directory emoji packs are stored in, relative paths are read from
# the working directory (default: ./emoji). One subdirectory per pack, each
# holding a `pack.json` manifest and its image files; the images are served
# by `GET /emoji/{pack}/{file}` and the packs are synced into the
# `custom_emojis` table at startup and after every pack change.
# EMOJI_DIR=./emoji

# Optional. Public prefix uploaded files' URLs are built from, without a
# trailing slash (default: {BASE_URL}/media). Point it at a CDN only if that
# CDN serves this instance's uploads directory; the instance always also
# serves files itself under /media.
# MEDIA_BASE_URL=https://cdn.example/media

# Optional. Job handlers a single worker runs at the same time (default: 10).
# JOB_CONCURRENCY=10

# Optional. Comma-separated job queue names the worker drains, in claim
# priority order (default: default,federator_incoming,federator_outgoing,mailer,scheduled,background).
# JOB_QUEUES=default,federator_incoming,federator_outgoing,mailer,scheduled,background

# Optional. Seconds between the heartbeat pings `GET /api/v1/streaming` sends
# each open WebSocket (default: 30). A socket that has not answered the ping it
# was last sent is closed on the next tick, so lowering it notices dead clients
# sooner and raises the traffic every streaming client pays.
# STREAMING_PING_INTERVAL_SECS=30

# Optional. SMTP relay host for outbound email (unset by default). While it
# is unset mail is disabled: emails are dropped at queue time (logged at
# debug), never sent, and a missing relay never fails a request.
# SMTP_HOST=smtp.example.org

# Optional. SMTP relay port (default: 587, the submission port). With
# SMTP_TLS=tls (SMTPS) an operator usually sets 465.
# SMTP_PORT=587

# Optional. SMTP relay login name and secret (both unset by default): sent
# together as AUTH only when both are set. The password is secret material
# and never written to a log.
# SMTP_USERNAME=relay-user
# SMTP_PASSWORD=relay-secret

# Optional. How the relay connection is encrypted: "starttls" (default,
# upgrade required before any credential is sent), "tls" (SMTPS for the whole
# connection) or "none" (plaintext, trusted local relay only).
# SMTP_TLS=starttls

# Optional. The From: address every sent email carries (default:
# noreply@<instance domain>, taken from BASE_URL; a port there is dropped).
# MAIL_FROM=noreply@social.example

# Optional. Rewrite remote media URLs (avatars, banners, attachments, remote
# custom emojis) into signed proxy links served by this instance under
# /proxy. Accepts true/false or 1/0, case-insensitive (default: false).
# MEDIA_PROXY_ENABLED=false

# Optional. HMAC-SHA256 signing secret for media proxy links (never logged;
# redacted in Debug output). Required, at least 32 characters, whenever
# MEDIA_PROXY_ENABLED is true. Generate one, e.g., with
# `openssl rand -hex 32`.
# MEDIA_PROXY_SECRET=

# Optional. Base URL proxy links are built from, without a trailing slash
# (default: BASE_URL). Point it at a CDN that fronts this instance's
# /proxy routes.
# MEDIA_PROXY_BASE_URL=https://cdn.example

# Optional. Hard cap on the bytes served for one proxied media file; the
# fetch aborts beyond it (default: 50000000).
# MEDIA_PROXY_MAX_BYTES=50000000

# Optional. Comma-separated hosts the media proxy never proxies; their URLs
# pass through to clients unchanged (default: empty).
# MEDIA_PROXY_BLACKLIST=example.org,cdn.example

# Optional. Whether routes that mount a rate-limit bucket throttle their
# requests; while off they answer uncounted and without x-ratelimit-*
# headers. Accepts true/false or 1/0, case-insensitive (default: true).
# RATE_LIMITS_ENABLED=true

# Optional. Overrides for the rate limiter's bucket table, as a
# comma-separated list of bucket=max:window_secs entries; each entry
# replaces the default for its bucket, an unknown name joins the table,
# and a bucket missing from it is unlimited. Defaults (Pleroma's):
# authentication=20:5, app_account_creation=5:1800, relations_actions=10:10,
# relation_id_action=2:60, statuses_actions=10:10, status_id_action=2:60,
# password_reset=5:1800, account_confirmation_resend=5:8600, search=30:60.
# RATE_LIMITS=authentication=20:5,app_account_creation=5:1800

# Optional. Whether the leftmost X-Forwarded-For entry may name the client
# a rate-limit window counts against; while off (default) the socket peer
# is always the client. Turn it on only behind a proxy that rewrites the
# header, or clients can mint fresh windows by changing it.
# TRUST_PROXY_HEADERS=false
