# Copy to `.env` for local development. `.env` is gitignored; never commit secrets.
# Real environment variables override values in `.env`.

# Required. PostgreSQL connection URL.
DATABASE_URL=postgres://wired:wired@localhost:5432/wired

# Optional. Address to listen on (default: 127.0.0.1:4000).
# BIND_ADDR=127.0.0.1:4000
