# Copy to `.env` for local development. `.env` is gitignored; never commit secrets.
# Real environment variables override values in `.env`.

# Required. PostgreSQL connection URL.
DATABASE_URL=postgres://wired:wired@localhost:5432/wired

# Required. Public origin of this instance: http(s) only, with a host and no
# path or query. A trailing slash is stripped; a non-default port is kept.
BASE_URL=https://social.example

# Optional. Origin the frontend pages are served from (default: BASE_URL).
# Browser redirects such as /notice/{id} send Location:
# {FRONTEND_BASE_URL}/notice/{id}, GET /oauth/authorize sends the browser to
# {FRONTEND_BASE_URL}/oauth/authorize (the consent screen), and the default-asset URLs
# (/images/avi.png, /images/banner.png, /images/thumbnail.jpg and
# /images/mascot.png, shipped by the frontend) are built from it, so it
# must name the frontend, not the API, when the two live on different
# origins. A trailing slash is stripped.
# FRONTEND_BASE_URL=https://frontend.example

# Optional. Address to listen on (default: 127.0.0.1:4000).
# BIND_ADDR=127.0.0.1:4000

# Optional. Instance display name (default: Wired).
# INSTANCE_NAME=Wired

# Optional. Short instance description
# (default: A Wired instance, compatible with Pleroma clients).
# INSTANCE_DESCRIPTION=A Wired instance, compatible with Pleroma clients

# Optional. Admin contact email (unset by default).
# CONTACT_EMAIL=admin@example.org

# Optional. Comma-separated content language codes (default: en).
# INSTANCE_LANGUAGES=en

# Optional. Maximum characters per status (default: 5000). `POST
# /api/v1/statuses` counts them the way clients do, charging each bare URL 23
# characters, and answers a longer post 422
# {"error":"The status is over the character limit"}.
# MAX_STATUS_CHARS=5000

# Optional. Maximum media attachments per status (default: 4).
# MAX_MEDIA_ATTACHMENTS=4

# Optional. Maximum options per poll (default: 20).
# MAX_POLL_OPTIONS=20

# Optional. Maximum characters per poll option (default: 200, Pleroma's
# `[:instance, :poll_limits, :max_option_chars]`). `POST /api/v1/statuses`
# refuses a poll carrying an empty option or a longer one with 422
# {"error":"Poll options cannot be longer than 200 characters"} (the message
# names this value).
# MAX_POLL_OPTION_CHARS=200

# Optional. Shortest poll expiration, in seconds (default: 300). `POST
# /api/v1/statuses` refuses a poll whose `poll[expires_in]` is shorter than
# this with 422 {"error":"Expiration date is too soon"}.
# MIN_POLL_EXPIRATION=300

# Optional. Longest poll expiration, in seconds (default: 31536000, one
# year, Pleroma's `[:instance, :poll_limits, :max_expiration]`). `POST
# /api/v1/statuses` refuses a poll whose `poll[expires_in]` is longer than
# this with 422 {"error":"Expiration date is too far in the future"}.
# MAX_POLL_EXPIRATION=31536000

# Optional. Maximum characters per chat message (default: 5000, Pleroma's
# `[:instance, :chat_limit]`). `POST /api/v1/pleroma/chats/{id}/messages`
# answers longer content 400 {"error":"The message is too long"}. The chat
# model independently refuses source text longer than 5000 characters when
# storing it, so raising this above 5000 has no effect on what is stored.
# MAX_CHAT_MESSAGE_CHARS=5000

# Optional. Maximum characters in a media attachment's description (alt
# text) (default: 1500, Mastodon's limit). `PUT /api/v1/media/{id}` refuses
# a longer `description` with 422 {"error":"Description too long"}.
# MAX_MEDIA_DESCRIPTION=1500

# Optional. Maximum characters in an account display name (default: 50,
# Mastodon's limit). `PATCH /api/v1/accounts/update_credentials` refuses a
# longer `display_name` with 422
# {"error":"Name is too long (maximum is 50 characters)"}.
# MAX_DISPLAY_NAME_CHARS=50

# Optional. Maximum characters in a profile note (bio) (default: 5000,
# Pleroma's `[:limiter, :user_bio_length]`).
# `PATCH /api/v1/accounts/update_credentials` refuses a longer `note` with
# 422 {"error":"Bio is too long (maximum is 5000 characters)"}.
# MAX_BIO_CHARS=5000

# Optional. Maximum number of profile metadata entries an account may
# store via `fields_attributes` (default: 4, Mastodon's limit).
# `PATCH /api/v1/accounts/update_credentials` refuses more entries with
# 422 {"error":"Too many fields"}.
# MAX_PROFILE_FIELDS=4

# Optional. Maximum characters in a report's `comment` (default: 1000,
# Mastodon's limit). `POST /api/v1/reports` refuses a longer comment with
# 422 {"error":"Validation failed: Comment is too long (maximum is 1000
# characters)"}.
# MAX_REPORT_COMMENT=1000

# Optional. Maximum number of statuses one account may pin to its profile
# (default: 1, Pleroma's `[:instance, :max_pinned_statuses]`). Mastodon
# clients ship 5, which is the value this instance's own v2 configuration
# block has reported since that endpoint landed; raise it to let accounts
# feature more than one post. `POST /api/v1/statuses/{id}/pin` refuses one
# past the limit with 422 {"error":"You have already pinned the maximum
# number of statuses"}.
# MAX_PINNED_STATUSES=5

# Optional. Shortest `expires_in` a status create may ask for, in seconds
# (default: 600, Pleroma's `:expiration, minimum_expiration_interval`).
# `POST /api/v1/statuses` refuses a shorter expiration with 422
# {"error":"expires_in must be at least 600 seconds"} (the message names
# this value), and stores an accepted one as the status's automatic
# deletion time.
# MIN_EXPIRATION_SECS=600

# Optional. How far in the future a `POST /api/v1/statuses` `scheduled_at`
# must be, in seconds (default: 300, Pleroma's `Pleroma.ScheduledActivity`
# `@min_offset` of five minutes). The scheduled-statuses window check reads
# it to refuse a `scheduled_at` less than this many seconds ahead.
# MIN_SCHEDULED_SECS=300

# Optional. How many pending scheduled rows one account may hold (default:
# 300, Pleroma's `[:Pleroma.ScheduledActivity, :total_user_limit]`). The
# per-user scheduled-status limit check reads it to refuse a `scheduled_at`
# past this count.
# MAX_SCHEDULED_PER_USER=300

# Optional. How many pending scheduled rows one account may hold for one UTC
# day (default: 25, Pleroma's `[:Pleroma.ScheduledActivity,
# :daily_user_limit]`). The per-user-per-day scheduled-status limit check
# reads it to refuse a `scheduled_at` on a day that already holds this many.
# MAX_SCHEDULED_PER_USER_PER_DAY=25

# Optional. Allow registering local accounts without an email address.
# Accepts true/false or 1/0, case-insensitive (default: false).
# ACCOUNTS_EMAIL_OPTIONAL=false

# Optional. Minimum length of a registration or reset password, in
# characters (default: 8).
# MIN_PASSWORD_LENGTH=8

# Optional. Lifetime granted to newly issued OAuth access tokens, in
# seconds (default: 2592000 — 30 days). The /oauth token endpoints stamp
# a token's `valid_until` with now() plus this value.
# OAUTH_TOKEN_TTL_SECS=2592000

# Optional. Lifetime of a password-reset token, in seconds (default:
# 86400 — 24 hours). `POST /auth/password` mints a token that is valid
# while it is unused and its issue time is within this window; the
# `GET`/`POST /api/v1/pleroma/password_reset` endpoints refuse it
# afterwards.
# PASSWORD_RESET_TTL_SECS=86400

# Optional. Whether accounts may delete their own account. Accepts
# true/false or 1/0, case-insensitive (default: true). While off, `POST
# /api/pleroma/delete_account` answers 403 {"error":"Account deletion is
# disabled"} without checking the password; `POST
# /api/pleroma/disable_account` (deactivate, keep the data) is unaffected.
# ALLOW_ACCOUNT_DELETION=true

# Optional. External OAuth login providers, as the JSON text of an array of
# provider objects (default: [] — no provider is configured, so every
# /oauth/prepare_request and /oauth/{provider} path answers for any name).
# Each object needs name, client_id, client_secret, authorize_url, token_url
# and userinfo_url; scopes and the four *_field names are optional (uid_field
# defaults to "id", the others to "" = the provider does not say). A field
# name is a dotted path into the provider's userinfo document. Invalid JSON
# refuses startup. The client_secret is never written to a log.
# OAUTH_PROVIDERS=[{"name":"github","client_id":"...","client_secret":"...","authorize_url":"https://github.com/login/oauth/authorize","token_url":"https://github.com/login/oauth/access_token","userinfo_url":"https://api.github.com/user","scopes":"read:user user:email","uid_field":"id","nickname_field":"login","email_field":"email","name_field":"name"}]

# Optional. Serve the MongooseIM auth endpoints `GET /user_exists` and
# `GET /check_password` for an external MongooseIM `extauth` http backend.
# Accepts true/false or 1/0, case-insensitive (default: false); while off,
# both paths answer the standard 404 {"error":"Not found"}.
# MONGOOSEIM_ENABLED=false

# Optional. Announce a captcha provider on `GET /api/v1/pleroma/captcha`.
# Accepts true/false or 1/0, case-insensitive (default: false). No captcha
# is implemented: with the flag off the endpoint answers
# {"type":"none"}; with it on, 501 {"error":"Captcha is not implemented"}.
# CAPTCHA_ENABLED=false

# Optional. Whether the instance accepts new local registrations. Accepts
# true/false or 1/0, case-insensitive (default: true, Pleroma's default);
# NodeInfo reports the state as `openRegistrations`.
# REGISTRATIONS_OPEN=true

# Optional. Whether registration invite tokens substitute for open
# registrations. Accepts true/false or 1/0, case-insensitive (default:
# false). While REGISTRATIONS_OPEN is true this changes nothing: the
# registration `token` parameter is optional and ignored. While
# registrations are closed, with this on a valid invite token
# (models/invite_tokens, administered by the later admin tickets) is
# required to register — anything else is 400 {"error":"Invalid token"} —
# and with it off every attempt is refused. `GET /api/v1/instance` reports
# the state as `invites_enabled`, NodeInfo as `invitesEnabled`.
# INVITES_ENABLED=false

# Optional. Whether a new account waits for staff approval before it may log
# in. Accepts true/false or 1/0, case-insensitive (default: false). With it
# on, POST /api/v1/accounts registers the account with approval pending and
# answers 200 {"message":"You have been registered. You'll be able to log in
# once your account is approved.","identifier":"awaiting_approval"} without a
# token, and every login is refused 403 with the same identifier until staff
# approve it (the admin approval flow is a later ticket). A registration that
# came in on an invite token skips the wait. GET /api/v1/instance and
# /api/v2/instance report the state as `approval_required`.
# REGISTRATIONS_APPROVAL_REQUIRED=false

# Optional. Whether an account must confirm its email address: a new one
# before it may log in, and a changed one before it is carried as confirmed.
# Accepts true/false or 1/0, case-insensitive (default: false). With it on,
# POST /api/v1/accounts registers the account unconfirmed, mints a
# confirmation token, queues the confirmation email carrying
# {BASE_URL}/api/account/confirm_email/{user_id}/{token} (which redirects
# the browser to {FRONTEND_BASE_URL}/ once visited) and answers 200
# {"message":"You have been registered. Please check your email for further
# instructions.","identifier":"missing_confirmed_email"} without a token; an
# unconfirmed login is refused 403 with the identifier
# `missing_confirmed_email`. While on, `POST /api/pleroma/change_email`
# leaves the account unconfirmed (`email_confirmed = false`) and queues a
# confirmation letter for the new address; the address change itself
# succeeds either way. GET /api/v1/instance reports the state as
# `account_activation_required`, NodeInfo as `accountActivationRequired`.
# Mail is queued only while SMTP_HOST is set (see below).
# ACCOUNT_ACTIVATION_REQUIRED=false

# Optional. Whether anonymous requests search statuses at
# `GET /api/v1/search` and `GET /api/v2/search`. Accepts true/false or 1/0,
# case-insensitive (default: false). While off, a request without a viewer
# answers an empty `statuses` list (accounts and hashtags search as
# before); while on, an anonymous status search sees the public and
# unlisted text it is allowed to see anyway. Authenticated searches are
# never gated by this.
# SEARCH_STATUSES_UNAUTHENTICATED=false

# Optional. Which reads an anonymous request may not make, as a
# comma-separated list of areas; each area names one read group and one half
# of the world, so `profiles_local` closes this instance's own accounts and
# `timelines_local` the local page of the public timeline (the full list is
# timelines_local, timelines_federated, profiles_local, profiles_remote,
# activities_local and activities_remote). Unset or empty — the default —
# keeps everything open, as a public instance does. An anonymous request to
# a closed area answers 403; a request presenting a valid user token is
# never refused for it. The refusal body is the endpoint's own: the account
# status listing (`GET /api/v1/accounts/{id}/statuses`, which reads
# profiles_local for a local account and profiles_remote for a mirror)
# answers {"error":"This API requires an authenticated user"} and the
# public timeline (`GET /api/v1/timelines/public`, which reads
# timelines_local for the `local=true` page and timelines_federated for
# every other anonymous page — `local=false` and `remote=true` included)
# answers {"error":"Authentication is required to access this resource."}.
# `activities_local` and `activities_remote` join as the status tickets
# gate their reads on them. Names outside that list refuse startup, so a
# typo cannot leave an area silently open.
# RESTRICT_UNAUTHENTICATED=profiles_local,profiles_remote

# Optional. Comma-separated list of frontends clients may pick at
# `PUT /api/v1/pleroma/preferred_frontend` (default: empty — no frontend is
# pickable, so `GET /api/v1/pleroma/preferred_frontend/available` answers
# `[]` and every pick is refused 422 {"error":"Invalid frontend"}).
# AVAILABLE_FRONTENDS=pleroma-fe

# Optional. Sign outgoing actor `GET`s with the instance actor's HTTP
# Signature (draft-cavage), so peers in authorized-fetch mode answer them.
# Accepts true/false or 1/0, case-insensitive (default: true). The instance
# actor (`{BASE_URL}/internal/fetch`) is created on first use.
# SIGN_FETCHES=true

# Optional. Require a valid HTTP Signature on `GET`s of the ActivityPub
# actor routes. Accepts true/false or 1/0, case-insensitive (default:
# false); while off, actor documents answer anonymous requests, and while
# on, unsigned or unverifiable requests get 401. `GET /internal/fetch`
# (the signer's own document) is never gated.
# AUTHORIZED_FETCH=false

# Optional. How far up a fetched thread the `federator.backfill` job walks
# to link a remote reply to its ancestors (default: 20). A thread deeper
# than this stays linked only as far as the depth allows.
# THREAD_FETCH_DEPTH=20

# Optional. How many remote object dereferences one incoming activity may
# trigger at most (default: 20). A fetch past the cap fails instead of
# fanning out further.
# MAX_FETCHES_PER_ACTIVITY=20

# Optional. Whether this instance federates at all. Accepts true/false or
# 1/0, case-insensitive (default: true). While off, every ActivityPub inbox
# `POST` (`/inbox`, `/users/{nickname}/inbox` and `/internal/fetch/inbox`)
# is refused with 403 {"error":"Federation is disabled"} — before
# authentication — and outbound delivery queues nothing.
# FEDERATION_ENABLED=true

# Optional. Whether public and unlisted remote statuses are stored even
# from authors no local account follows (default: true). While false, the
# ingest path drops such a post — it appears in no timeline and reaches no
# home feed — unless a local user is mentioned in it or it answers a local
# status. `private` (followers-addressed) and `direct` posts are never
# gated: they were aimed at somebody here. Accepts true/false or 1/0,
# case-insensitive.
# ACCEPT_UNSOLICITED_PUBLIC=true

# Optional. How long, in seconds, a host carrying an unreachable mark keeps
# receiving outbound activities (default: 0). `src/models/instance.rs` reads a
# host from the `instances` table as unreachable only when its
# `unreachable_since` mark is older than this window, so with a positive value
# one fresh mark does not take a peer out of the fan-out; 0 makes any marked
# host unreachable at once, which is Pleroma's behaviour.
# UNREACHABLE_GRACE_SECS=0

# Optional. Comma-separated MRF (moderation/filter pipeline) policy names
# to run over every incoming and outgoing activity — `noop`, `simple`,
# `anti_link_spam`, `normalize_markup`, `tag`, `keyword`, `hellthread` and
# `object_age` today; policy tickets register more. `simple` reads its
# domain lists from
# the `simple` key of the same setting (see the README's
# "Moderation filters (MRF)"). This is the fallback: the `mrf` instance setting
# (JSON {"policies": [...], "<policy>": {...}}, read by the pipeline and
# cached for 30 s) wins whenever it carries a `policies` array. The active
# names are advertised in the federation block of `GET /api/v1/instance`,
# `GET /api/v2/instance` and `NodeInfo`, while `MRF_TRANSPARENCY` is on.
# MRF_POLICIES=noop

# Optional. Whether the enabled MRF policies publish their moderation
# lists: the `mrf_policies` names beside the `mrf_simple`,
# `mrf_simple_info` and `mrf_<policy>` objects in the federation block of
# `GET /api/v1/instance`, `GET /api/v2/instance` and `NodeInfo`, and the
# domain lists `GET /api/v1/instance/domain_blocks` renders as Mastodon
# domain blocks. Accepts true/false or 1/0, case-insensitive (default:
# true, Pleroma's `[:mrf, :transparency]`). With it off those publish
# nothing — the federation block is `{"enabled": true, "mrf_policies": [],
# "exclusions": false}` and the domain-block listing is `[]` — while the
# filters keep running. `GET /api/v1/instance/peers` hides rejected hosts
# either way: the switch is about publishing, not about talking.
# MRF_TRANSPARENCY=true

# Optional. Comma-separated host patterns kept out of those published
# lists (Pleroma's `[:mrf, :transparency_exclusions]`, default: empty).
# They match with the same rules the policy lists themselves use, so
# `*.example.com` hides that entry, every entry below it, and its reason.
# Using the feature is itself disclosed as `"exclusions": true` — on the
# strength of the setting, whether or not anything matched. An excluded
# host stays blocked; only its name is withheld. See the README's
# "Transparency: publishing the lists".
# MRF_TRANSPARENCY_EXCLUSIONS=*.partner.example,press.example

# Optional. Report pool and liveness data on
# `GET /api/v1/pleroma/healthcheck`. Accepts true/false or 1/0,
# case-insensitive (default: false); while off the path answers the
# standard 404 {"error":"Not found"}. When on, the answer is 200 or 503
# with the sqlx pool counts and a `SELECT 1` probe result.
# HEALTHCHECK_ENABLED=false

# Optional. Maximum size of one uploaded file in a multipart request, in
# bytes (default: 16000000). Keep it under the middleware's 16 MiB overall
# body cap unless the upload router raises that too.
# UPLOAD_LIMIT_BYTES=16000000

# Optional. Maximum number of files in one multipart request (default: 16).
# UPLOAD_MAX_FILES=16

# Optional. Maximum size of the `avatar` image accepted by
# `PATCH /api/v1/accounts/update_credentials`, in bytes (default: 2000000,
# Pleroma's avatar limit). A larger avatar is refused with 422
# {"error":"File is too large"}; the `header` and
# `pleroma_background_image` parts are measured by BANNER_LIMIT_BYTES.
# AVATAR_LIMIT_BYTES=2000000

# Optional. Maximum size of the `header` and `pleroma_background_image`
# images accepted by `PATCH /api/v1/accounts/update_credentials`, in bytes
# (default: 4000000, Pleroma's banner and background limit). A larger one is
# refused with 422 {"error":"File is too large"}.
# BANNER_LIMIT_BYTES=4000000

# Optional. Hard cap on one inbound ActivityPub inbox request body, in
# bytes (default: 1048576 — 1 MiB). The SignedActivity extractor answers a
# larger body 413 {"error":"Payload too large"}; keep it under the
# middleware's 16 MiB overall body cap.
# INBOX_MAX_BYTES=1048576

# Optional. How many unknown-remote `@nick@domain` mentions one status may
# look up over the network while it is composed (default: 10). The lookups
# run together under one shared five-second budget; a mention whose domain
# does not answer, and every mention past the cap, stays plain text and the
# status is created regardless.
# MAX_REMOTE_MENTION_LOOKUPS=10

# Optional. Maximum pixel count (width times height) of an uploaded image
# (default: 40000000 — 40 megapixels). `POST /api/v1/media` and
# `POST /api/v2/media` read an image's header before decoding it and reject
# a larger one with 422 {"error":"Image too large"}; undecodable image bytes
# are rejected with 422 {"error":"Invalid image"}.
# MAX_IMAGE_PIXELS=40000000

# Optional. Allow outbound HTTP requests to private, loopback, and other
# reserved addresses, disabling the SSRF guard, and answer WebFinger lookups
# of nick@host:port handles over plain http:// that authority (the RFC's
# https-only base cannot reach a port-addressed dev peer). Accepts
# true/false or 1/0, case-insensitive (default: false). Development and test
# only: a federating instance must keep the guard on.
# HTTP_ALLOW_PRIVATE_HOSTS=false

# Optional. Directory uploaded files are stored in, relative paths are read
# from the working directory (default: ./uploads). It must be writable by the
# server; the files in it are public to anyone who holds their URL.
# UPLOADS_DIR=./uploads

# Optional. Directory emoji packs are stored in, relative paths are read from
# the working directory (default: ./emoji). One subdirectory per pack, each
# holding a `pack.json` manifest and its image files; the images are served
# by `GET /emoji/{pack}/{file}` and the packs are synced into the
# `custom_emojis` table at startup and after every pack change.
# EMOJI_DIR=./emoji

# Optional. Public prefix uploaded files' URLs are built from, without a
# trailing slash (default: {BASE_URL}/media). Point it at a CDN only if that
# CDN serves this instance's uploads directory; the instance always also
# serves files itself under /media.
# MEDIA_BASE_URL=https://cdn.example/media

# Optional. Job handlers a single worker runs at the same time (default: 10).
# JOB_CONCURRENCY=10

# Optional. Comma-separated job queue names the worker drains, in claim
# priority order (default: default,federator_incoming,federator_outgoing,mailer,scheduled,background).
# JOB_QUEUES=default,federator_incoming,federator_outgoing,mailer,scheduled,background

# Optional. Age in days after which the daily maintenance job hard-deletes
# statuses this instance soft-deleted; 0 disables the purge (default: 30).
# Tombstones of remote posts are never deleted: their rows keep a deleted
# remote post from being re-imported. Rows that reference a purged status
# (media attachments, favourites, notifications) follow it.
# PURGE_DELETED_STATUSES_DAYS=30

# Optional. Age in days a finished user backup archive stays downloadable
# (default: 30). The window opens when the archive is written; after it passes
# the archive is no longer offered.
# BACKUP_VALIDITY_DAYS=30

# Optional. Minimum number of days between two backups of one user (default:
# 7). A request for a fresh backup before this much time has passed since the
# user's last one is refused.
# BACKUP_LIMIT_DAYS=7

# Optional. Whether the backup purge sweep runs at all. Accepts true/false or
# 1/0, case-insensitive (default: true). While off, no backup archive is ever
# deleted by the sweep, whatever BACKUP_VALIDITY_DAYS says.
# BACKUP_PURGE=true

# Optional. Seconds between the heartbeat pings `GET /api/v1/streaming` sends
# each open WebSocket (default: 30). A socket that has not answered the ping it
# was last sent is closed on the next tick, so lowering it notices dead clients
# sooner and raises the traffic every streaming client pays.
# STREAMING_PING_INTERVAL_SECS=30

# Optional. SMTP relay host for outbound email (unset by default). While it
# is unset mail is disabled: emails are dropped at queue time (logged at
# debug), never sent, and a missing relay never fails a request.
# SMTP_HOST=smtp.example.org

# Optional. SMTP relay port (default: 587, the submission port). With
# SMTP_TLS=tls (SMTPS) an operator usually sets 465.
# SMTP_PORT=587

# Optional. SMTP relay login name and secret (both unset by default): sent
# together as AUTH only when both are set. The password is secret material
# and never written to a log.
# SMTP_USERNAME=relay-user
# SMTP_PASSWORD=relay-secret

# Optional. How the relay connection is encrypted: "starttls" (default,
# upgrade required before any credential is sent), "tls" (SMTPS for the whole
# connection) or "none" (plaintext, trusted local relay only).
# SMTP_TLS=starttls

# Optional. The From: address every sent email carries (default:
# noreply@<instance domain>, taken from BASE_URL; a port there is dropped).
# MAIL_FROM=noreply@social.example

# Optional. Rewrite remote media URLs (avatars, banners, attachments, remote
# custom emojis) into signed proxy links served by this instance under
# /proxy. Accepts true/false or 1/0, case-insensitive (default: false).
# MEDIA_PROXY_ENABLED=false

# Optional. HMAC-SHA256 signing secret for media proxy links (never logged;
# redacted in Debug output). Required, at least 32 characters, whenever
# MEDIA_PROXY_ENABLED is true. Generate one, e.g., with
# `openssl rand -hex 32`.
# MEDIA_PROXY_SECRET=

# Optional. Base URL proxy links are built from, without a trailing slash
# (default: BASE_URL). Point it at a CDN that fronts this instance's
# /proxy routes.
# MEDIA_PROXY_BASE_URL=https://cdn.example

# Optional. Hard cap on the bytes served for one proxied media file; the
# fetch aborts beyond it (default: 50000000).
# MEDIA_PROXY_MAX_BYTES=50000000

# Optional. Comma-separated hosts the media proxy never proxies; their URLs
# pass through to clients unchanged (default: empty).
# MEDIA_PROXY_BLACKLIST=example.org,cdn.example

# Optional. How many served URLs the media-proxy cache ledger keeps at
# most; recording a new one prunes the oldest rows past the cap (default:
# 100000). The admin media_proxy_caches endpoints list, delete and purge
# this ledger.
# MEDIA_PROXY_CACHE_LIMIT=100000

# Optional. Origin PURGE cache-invalidation requests are sent to when an
# admin deletes or purges media-proxy cache entries, without a trailing
# slash (default: unset — no PURGE requests are sent, only the ledger rows
# are removed). A request failure is logged and never fails the action.
# MEDIA_PROXY_PURGE_URL=http://cache.example

# Optional. Directory installed frontends live in (default: ./frontends).
# The admin installer lands each build at <FRONTENDS_DIR>/<name>/<ref>.
# FRONTENDS_DIR=/srv/pleroma/frontends

# Optional. JSON array describing the installable frontends shown by
# GET /api/v1/pleroma/admin/frontends and installable through
# POST /api/v1/pleroma/admin/frontends/install. Keys: name (required),
# git, build_url (may carry the ${ref} placeholder), ref, build_dir.
# Invalid JSON refuses startup (default: []).
# FRONTENDS_AVAILABLE=[{"name":"pleroma-fe","git":"https://git.example/pleroma-fe","build_url":"https://build.example/pleroma-fe-${ref}.zip","ref":"master","build_dir":"dist"}]

# Optional. Directory the instance documents (static HTML pages like the
# terms of service) are stored in, relative paths are read from the working
# directory (default: ./instance). Each document named by
# INSTANCE_DOCUMENT_NAMES is one `<name>.html` file in it, written by
# `PATCH /api/v1/pleroma/admin/instance_document/{name}` and served,
# unauthenticated, at `GET /instance/{name}.html`.
# INSTANCE_DOCS_DIR=/srv/pleroma/instance

# Optional. Comma-separated list of the instance document names the admin
# and public document routes serve, each stored as `<name>.html` under
# INSTANCE_DOCS_DIR (default: terms-of-service,instance-panel). A name off
# this list is the routes' 404.
# INSTANCE_DOCUMENT_NAMES=terms-of-service,instance-panel

# Optional. Comma-separated hosts rich media card fetching never visits; a
# link to one of them is never fetched and gets no card (default: empty),
# the same trimmed list the media proxy's blacklist reads.
# RICH_MEDIA_IGNORE_HOSTS=example.org,cdn.example

# Optional. Whether preview cards are fetched for the remote URLs statuses
# link to. Accepts true/false or 1/0, case-insensitive (default: false).
# RICH_MEDIA_REMOTE=false

# Optional. Which service translates statuses for
# POST /api/v1/statuses/{id}/translate: "none" (the default),
# "libretranslate" or "deepl" (case-insensitive); any other name refuses
# startup. While "none", the endpoint answers 503 {"error":"Translation is
# not enabled"}, GET /api/v1/instance/translation_languages answers {} and
# the v2 instance document reports configuration.translation.enabled false.
# TRANSLATION_PROVIDER=none

# Optional. The provider's API base URL, without a trailing slash: the
# translate and language-list endpoints are looked up beneath it, e.g.
# https://translate.example for a LibreTranslate server or
# https://api-free.deepl.com for DeepL. A selected provider with no URL here
# is not used, exactly as "none".
# TRANSLATION_API_URL=https://translate.example

# Optional. The provider's API key (never logged; redacted in debug output).
# Required for "deepl", which has no unauthenticated mode and is not used
# without one; a self-hosted "libretranslate" usually needs no key and
# receives an empty one.
# TRANSLATION_API_KEY=

# Optional. The instance's Web Push (VAPID) private key: an ES256 signing
# key as PKCS#8 PEM (never logged; redacted in Debug output). With none
# set, startup generates a key pair into the instance_secrets table and
# keeps it across restarts; setting this overwrites that pair at every
# startup. The matching public half is derived from it; VAPID_PUBLIC_KEY,
# if also set, must equal that derived half or startup fails.
# VAPID_PRIVATE_KEY=-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----

# Optional. The instance's Web Push (VAPID) public key: URL-safe base64
# (no padding) of the uncompressed P-256 point. This is the server_key
# push clients receive from /api/v1/push/subscription and the vapid_key
# / vapid_public_key of the app and instance responses; it is not secret.
# It is only a cross-check: it requires VAPID_PRIVATE_KEY (set alone, the
# config is rejected) and must match the key derived from it, since a
# mismatched pair makes every push delivery fail.
# VAPID_PUBLIC_KEY=

# Optional. Whether routes that mount a rate-limit bucket throttle their
# requests; while off they answer uncounted and without x-ratelimit-*
# headers. Accepts true/false or 1/0, case-insensitive (default: true).
# RATE_LIMITS_ENABLED=true

# Optional. Overrides for the rate limiter's bucket table, as a
# comma-separated list of bucket=max:window_secs entries; each entry
# replaces the default for its bucket, an unknown name joins the table,
# and a bucket missing from it is unlimited. Defaults (Pleroma's):
# authentication=20:5, app_account_creation=5:1800, relations_actions=10:10,
# relation_id_action=2:60, statuses_actions=10:10, status_id_action=2:60,
# password_reset=5:1800, account_confirmation_resend=5:8600, search=30:60,
# imports=1:3600 (the follow/blocks/mutes CSV imports, one per hour).
# RATE_LIMITS=authentication=20:5,app_account_creation=5:1800

# Optional. Whether X-Forwarded-For may name the client a rate-limit window
# counts against: the rightmost entry (the hop your reverse proxy appended;
# see TRUSTED_PROXY_HOPS). While off (default) the socket peer is always the
# client. Turn it on only behind a proxy that appends to the header.
# TRUST_PROXY_HEADERS=false

# Optional. How many reverse proxies sit in front of the server (default 1).
# With TRUST_PROXY_HEADERS on, the client is the X-Forwarded-For entry that
# many places from the right; a shorter header or a non-IP entry falls back
# to the socket peer.
# TRUSTED_PROXY_HOPS=1
